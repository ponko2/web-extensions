amends "package://github.com/jdx/hk/releases/download/v2.6.0/hk@2.6.0#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v2.6.0/hk@2.6.0#/Builtins.pkl"

steps {
  ["editorconfig_checker"] = Builtins.editorconfig_checker
  ["ghalint_action"] = Builtins.ghalint_action
  ["ghalint_workflow"] = Builtins.ghalint_workflow
  ["jactionlint"] = Builtins.jactionlint
  ["ryl"] = Builtins.ryl
  ["vp_check"] = (Builtins.vp_check) {
    check = new CommandSpec {
      command = new Command {
        argv = List("vp", "check", "--no-error-on-unmatched-pattern", "{{files}}")
      }
      effect = "read"
    }
    fix = new CommandSpec {
      command = new Command {
        argv = List("vp", "check", "--fix", "--no-error-on-unmatched-pattern", "{{files}}")
      }
      effect = "write"
    }
  }
  ["zizmor"] = Builtins.zizmor
}

hooks {
  ["commit-msg"] {
    steps {
      ["commitlint"] {
        check = "commitlint --edit {{commit_msg_file}}"
      }
    }
  }
}
